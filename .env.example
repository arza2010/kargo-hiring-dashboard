# Copy to .env and fill in your own real values. Never commit .env.
#
# (An earlier local copy of this file had real, working Gemini/Resend keys
# in it. Caught and scrubbed before this repo was ever created or pushed —
# they were never in git history. Still worth rotating those keys as a
# precaution, since they sat in a plain file on disk for a while.)
GEMINI_API_KEY=
GEMINI_MODEL=
RESEND_API_KEY=
EMAIL_FROM=Kargo Hiring <onboarding@resend.dev>
DEMO_MODE=true
DEMO_RECIPIENT=

# Neon (Postgres) connection string. Added when the database was switched
# from SQLite to Neon mid-build — see PLAN.md section 3a. Get this from your
# Neon project's dashboard (Connection Details -> pooled connection string).
DATABASE_URL=

# Only needed if this app is deployed somewhere reachable from outside your
# own machine (see app/auth.py). Leave both unset for local, unauthenticated
# use — matches CLAUDE.md's original v1 spec.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
